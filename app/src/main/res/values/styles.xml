<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- ============================================== -->
    <!-- PulseCheck Design System - Styles -->
    <!-- ============================================== -->
    
    <!-- ==================== Text Styles ==================== -->
    
    <!-- Display Text (32sp) -->
    <style name="TextAppearance.PulseCheck.Display" parent="TextAppearance.Material3.DisplaySmall">
        <item name="android:textSize">@dimen/text_display</item>
        <item name="android:textColor">@color/pulse_text_primary</item>
        <item name="fontFamily">sans-serif-medium</item>
    </style>
    
    <!-- Headline Text (24sp) -->
    <style name="TextAppearance.PulseCheck.Headline" parent="TextAppearance.Material3.HeadlineSmall">
        <item name="android:textSize">@dimen/text_headline</item>
        <item name="android:textColor">@color/pulse_text_primary</item>
        <item name="fontFamily">sans-serif-medium</item>
    </style>
    
    <!-- Title Text (20sp) -->
    <style name="TextAppearance.PulseCheck.Title" parent="TextAppearance.Material3.TitleMedium">
        <item name="android:textSize">@dimen/text_title</item>
        <item name="android:textColor">@color/pulse_text_primary</item>
        <item name="fontFamily">sans-serif-medium</item>
    </style>
    
    <!-- Body Text (16sp) -->
    <style name="TextAppearance.PulseCheck.Body" parent="TextAppearance.Material3.BodyLarge">
        <item name="android:textSize">@dimen/text_body</item>
        <item name="android:textColor">@color/pulse_text_primary</item>
        <item name="fontFamily">sans-serif</item>
    </style>
    
    <!-- Caption Text (14sp) -->
    <style name="TextAppearance.PulseCheck.Caption" parent="TextAppearance.Material3.BodySmall">
        <item name="android:textSize">@dimen/text_caption</item>
        <item name="android:textColor">@color/pulse_text_secondary</item>
        <item name="fontFamily">sans-serif</item>
    </style>
    
    <!-- Small Text (12sp) -->
    <style name="TextAppearance.PulseCheck.Small" parent="TextAppearance.Material3.LabelSmall">
        <item name="android:textSize">@dimen/text_small</item>
        <item name="android:textColor">@color/pulse_text_secondary</item>
        <item name="fontFamily">sans-serif</item>
    </style>
    
    <!-- ==================== Button Styles ==================== -->
    
    <!-- Primary Button (Coral) -->
    <style name="Widget.PulseCheck.Button.Primary" parent="Widget.Material3.Button">
        <item name="android:background">@drawable/bg_button_primary</item>
        <item name="android:textColor">@color/pulse_button_text</item>
        <item name="android:textSize">@dimen/text_body</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:minHeight">@dimen/button_height</item>
        <item name="android:paddingStart">@dimen/button_padding_horizontal</item>
        <item name="android:paddingEnd">@dimen/button_padding_horizontal</item>
        <item name="cornerRadius">@dimen/button_corner_radius</item>
    </style>
    
    <!-- Secondary Button (Light Coral) -->
    <style name="Widget.PulseCheck.Button.Secondary" parent="Widget.Material3.Button.OutlinedButton">
        <item name="android:background">@drawable/bg_button_secondary</item>
        <item name="android:textColor">@color/pulse_text_primary</item>
        <item name="android:textSize">@dimen/text_body</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:minHeight">@dimen/button_height</item>
        <item name="cornerRadius">@dimen/button_corner_radius</item>
    </style>
    
    <!-- ==================== Input Field Styles ==================== -->
    
    <!-- Material Input Layout Style -->
    <style name="Widget.PulseCheck.TextInputLayout" parent="Widget.Material3.TextInputLayout.OutlinedBox">
        <item name="boxBackgroundColor">@color/pulse_input_bg</item>
        <item name="boxStrokeColor">@color/pulse_input_border</item>
        <item name="boxCornerRadiusTopStart">@dimen/input_corner_radius</item>
        <item name="boxCornerRadiusTopEnd">@dimen/input_corner_radius</item>
        <item name="boxCornerRadiusBottomStart">@dimen/input_corner_radius</item>
        <item name="boxCornerRadiusBottomEnd">@dimen/input_corner_radius</item>
        <item name="hintTextColor">@color/pulse_input_hint</item>
        <item name="android:textColorHint">@color/pulse_input_hint</item>
    </style>
    
    <!-- Edit Text Style -->
    <style name="Widget.PulseCheck.EditText" parent="Widget.Material3.TextInputEditText.OutlinedBox">
        <item name="android:textColor">@color/pulse_input_text</item>
        <item name="android:textSize">@dimen/text_body</item>
        <item name="android:fontFamily">sans-serif</item>
        <item name="android:minHeight">@dimen/input_height</item>
        <item name="android:paddingStart">@dimen/input_padding_horizontal</item>
        <item name="android:paddingEnd">@dimen/input_padding_horizontal</item>
    </style>
    
    <!-- ==================== Card Styles ==================== -->
    
    <!-- Base Card Style -->
    <style name="Widget.PulseCheck.Card" parent="Widget.Material3.CardView.Elevated">
        <item name="cardBackgroundColor">@color/pulse_card_bg</item>
        <item name="cardCornerRadius">@dimen/card_corner_radius</item>
        <item name="cardElevation">@dimen/card_elevation</item>
        <item name="contentPadding">@dimen/card_padding</item>
    </style>
    
    <!-- Contact Card Style -->
    <style name="Widget.PulseCheck.ContactCard" parent="Widget.PulseCheck.Card">
        <item name="cardCornerRadius">@dimen/contact_card_corner_radius</item>
        <item name="android:layout_marginTop">@dimen/contact_card_margin_vertical</item>
        <item name="android:layout_marginBottom">@dimen/contact_card_margin_vertical</item>
        <item name="contentPadding">@dimen/contact_card_padding</item>
    </style>
    
    <!-- ==================== Navigation Styles ==================== -->
    
    <!-- Navigation Bar Container -->
    <style name="Widget.PulseCheck.NavigationBar">
        <item name="android:background">@drawable/bg_navigation_bar</item>
        <item name="android:elevation">8dp</item>
        <item name="android:layout_height">@dimen/nav_bar_height</item>
        <item name="android:layout_margin">@dimen/nav_bar_margin</item>
    </style>
    
    <!-- Navigation Item Text -->
    <style name="TextAppearance.PulseCheck.Navigation" parent="TextAppearance.Material3.LabelSmall">
        <item name="android:textSize">@dimen/nav_text_size</item>
        <item name="fontFamily">sans-serif</item>
    </style>
    
    <!-- ==================== Avatar Styles ==================== -->
    
    <!-- Small Avatar (40dp) -->
    <style name="Widget.PulseCheck.Avatar.Small">
        <item name="android:layout_width">@dimen/avatar_small</item>
        <item name="android:layout_height">@dimen/avatar_small</item>
        <item name="android:background">@drawable/bg_avatar_circle</item>
    </style>
    
    <!-- Medium Avatar (64dp) -->
    <style name="Widget.PulseCheck.Avatar.Medium">
        <item name="android:layout_width">@dimen/avatar_medium</item>
        <item name="android:layout_height">@dimen/avatar_medium</item>
        <item name="android:background">@drawable/bg_avatar_circle</item>
    </style>
    
    <!-- Large Avatar (120dp) -->
    <style name="Widget.PulseCheck.Avatar.Large">
        <item name="android:layout_width">@dimen/avatar_large</item>
        <item name="android:layout_height">@dimen/avatar_large</item>
        <item name="android:background">@drawable/bg_avatar_profile</item>
    </style>
    
    <!-- ==================== Special Components ==================== -->
    
    <!-- SOS Heart Button -->
    <style name="Widget.PulseCheck.SOSButton">
        <item name="android:layout_width">@dimen/sos_button_size</item>
        <item name="android:layout_height">@dimen/sos_button_size</item>
        <item name="android:background">@drawable/bg_sos_button</item>
    </style>
    
    <!-- Search Bar -->
    <style name="Widget.PulseCheck.SearchBar">
        <item name="android:background">@drawable/bg_search_bar</item>
        <item name="android:minHeight">@dimen/search_bar_height</item>
        <item name="android:paddingStart">@dimen/input_padding_horizontal</item>
        <item name="android:paddingEnd">@dimen/input_padding_horizontal</item>
    </style>
    
    <!-- Contact Carousel Container -->
    <style name="Widget.PulseCheck.ContactCarousel">
        <item name="android:background">@drawable/bg_contact_carousel</item>
        <item name="android:minHeight">@dimen/carousel_height</item>
        <item name="android:padding">@dimen/carousel_padding</item>
    </style>
    
    <!-- Add Contact Button -->
    <style name="Widget.PulseCheck.AddContactButton" parent="Widget.PulseCheck.Button.Secondary">
        <item name="android:background">@drawable/bg_add_contact_button</item>
        <item name="android:minHeight">@dimen/add_contact_button_height</item>
        <item name="cornerRadius">@dimen/add_contact_button_corner_radius</item>
    </style>
    
</resources>
