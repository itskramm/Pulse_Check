<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginVertical="8dp"
    app:cardCornerRadius="12dp"
    app:cardElevation="2dp"
    app:cardBackgroundColor="@color/white">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <!-- Header with Cloud Icon -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <!-- Video Icon -->
            <ImageView
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:src="@android:drawable/ic_media_play"
                app:tint="@color/pulse_primary"
                android:padding="8dp"
                android:background="@drawable/bg_icon_tint_circle" />

            <!-- Video Info -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:layout_marginStart="12dp">

                <TextView
                    android:id="@+id/tv_file_name"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="SOS_VIDEO_20240930_143022.mp4"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:textColor="@color/text_primary"
                    android:maxLines="1"
                    android:ellipsize="middle" />

                <TextView
                    android:id="@+id/tv_file_date"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Recorded: 2024-09-30 14:30:22"
                    android:textSize="12sp"
                    android:textColor="@color/text_secondary"
                    android:layout_marginTop="4dp" />

            </LinearLayout>

            <!-- Cloud Backup Indicator -->
            <ImageView
                android:id="@+id/iv_cloud_icon"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:src="@android:drawable/ic_menu_upload"
                app:tint="@color/pulse_primary"
                android:layout_marginStart="8dp"
                android:visibility="gone" />

        </LinearLayout>

        <!-- Metadata Row -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="12dp"
            android:gravity="center_vertical">

            <TextView
                android:id="@+id/tv_file_duration"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="⏱ 0:12"
                android:textSize="11sp"
                android:textColor="@color/text_secondary"
                android:layout_marginEnd="12dp"
                android:background="@drawable/bg_white_field"
                android:paddingHorizontal="8dp"
                android:paddingVertical="4dp" />

            <TextView
                android:id="@+id/tv_file_size"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="📁 2.5 MB"
                android:textSize="11sp"
                android:textColor="@color/text_secondary"
                android:background="@drawable/bg_white_field"
                android:paddingHorizontal="8dp"
                android:paddingVertical="4dp" />

            <View
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_weight="1" />

            <TextView
                android:id="@+id/tv_shared_count"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="✓ Shared with 3 contacts"
                android:textSize="11sp"
                android:textColor="@color/pulse_primary"
                android:textStyle="bold"
                android:visibility="gone" />

        </LinearLayout>

        <!-- Action Buttons -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="12dp"
            android:gravity="center">

            <TextView
                android:id="@+id/btn_play"
                android:layout_width="0dp"
                android:layout_height="40dp"
                android:layout_weight="1"
                android:text="▶ Play"
                android:textSize="13sp"
                android:textStyle="bold"
                android:textColor="@color/white"
                android:background="@drawable/bg_auth_button"
                android:gravity="center"
                android:layout_marginEnd="4dp"
                android:clickable="true"
                android:focusable="true" />

            <TextView
                android:id="@+id/btn_share"
                android:layout_width="0dp"
                android:layout_height="40dp"
                android:layout_weight="1"
                android:text="📤 Share"
                android:textSize="13sp"
                android:textStyle="bold"
                android:textColor="@color/pulse_primary"
                android:background="@drawable/bg_white_field"
                android:gravity="center"
                android:layout_marginHorizontal="4dp"
                android:clickable="true"
                android:focusable="true" />

            <TextView
                android:id="@+id/btn_info"
                android:layout_width="0dp"
                android:layout_height="40dp"
                android:layout_weight="1"
                android:text="ℹ️ Info"
                android:textSize="13sp"
                android:textStyle="bold"
                android:textColor="@color/pulse_primary"
                android:background="@drawable/bg_white_field"
                android:gravity="center"
                android:layout_marginHorizontal="4dp"
                android:clickable="true"
                android:focusable="true" />

            <TextView
                android:id="@+id/btn_delete"
                android:layout_width="0dp"
                android:layout_height="40dp"
                android:layout_weight="1"
                android:text="🗑"
                android:textSize="16sp"
                android:textColor="@color/pulse_alert"
                android:background="@drawable/bg_white_field"
                android:gravity="center"
                android:layout_marginStart="4dp"
                android:clickable="true"
                android:focusable="true" />

        </LinearLayout>

    </LinearLayout>

</androidx.cardview.widget.CardView>
