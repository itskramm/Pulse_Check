<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/custom_splashbackground"
    tools:context=".Splash">

    <ImageView
        android:id="@+id/blob_shape"
        android:layout_width="320dp"
        android:layout_height="320dp"
        android:src="@drawable/splash"
        app:tint="#FFFFFF"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:contentDescription="White background blob" />

    <ImageView
        android:id="@+id/heart_icon"
        android:layout_width="200dp"
        android:layout_height="200dp"
        android:src="@drawable/pulselogo"
        app:layout_constraintTop_toTopOf="@id/blob_shape"
        app:layout_constraintBottom_toBottomOf="@id/blob_shape"
        app:layout_constraintStart_toStartOf="@id/blob_shape"
        app:layout_constraintEnd_toEndOf="@id/blob_shape"
        android:contentDescription="Pulse Check Heart Icon" />

    <TextView
        android:id="@+id/app_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="PulseCheck"
        android:textColor="#E43D12"
        android:textSize="32sp"
        android:textStyle="bold"
        android:fontFamily="sans-serif-black"
        android:layout_marginTop="8dp"
        app:layout_constraintTop_toBottomOf="@id/heart_icon"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>