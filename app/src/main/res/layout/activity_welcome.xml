<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:id="@+id/main"
    android:layout_height="match_parent"
    android:background="@drawable/bg_onboarding"
    tools:context=".Welcome">

    <!-- The White Organic Blob -->
    <ImageView
        android:id="@+id/ivCenterBlob"
        android:layout_width="350dp"
        android:layout_height="350dp"
        android:background="@drawable/bg_white_blob"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_bias="0.15" />

    <!-- The Main Pulse Logo -->
    <ImageView
        android:id="@+id/img_main_logo"
        android:layout_width="220dp"
        android:layout_height="220dp"
        android:src="@drawable/pulselogo"
        app:layout_constraintBottom_toBottomOf="@+id/ivCenterBlob"
        app:layout_constraintEnd_toEndOf="@+id/ivCenterBlob"
        app:layout_constraintStart_toStartOf="@+id/ivCenterBlob"
        app:layout_constraintTop_toTopOf="@+id/ivCenterBlob" />

    <!-- Log in Button -->
    <Button
        android:id="@+id/btnContinue"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:layout_marginHorizontal="40dp"
        android:layout_marginBottom="16dp" android:backgroundTint="#e1f2f3"
        android:elevation="8dp"
        android:text="Log in"
        android:textAllCaps="false"
        android:textColor="#0e6995"
        android:textSize="16sp"
        android:textStyle="bold"
        app:cornerRadius="16dp"
        app:layout_constraintBottom_toTopOf="@+id/btn_create_account"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

    <Button
        android:id="@+id/btn_create_account"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:layout_marginHorizontal="40dp"
        android:layout_marginBottom="64dp" android:elevation="8dp"
        android:backgroundTint="#e1f2f3"
        android:text="Create an account"
        android:textAllCaps="false"
        android:textColor="#0e6995"
        android:textSize="16sp"
        android:textStyle="bold"
        app:cornerRadius="16dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent" />
</androidx.constraintlayout.widget.ConstraintLayout>