<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:gravity="center"
    android:layout_marginEnd="@dimen/spacing_sm"
    android:padding="4dp">
    
    <ImageView
        android:id="@+id/carouselContactAvatar"
        android:layout_width="@dimen/carousel_avatar_size"
        android:layout_height="@dimen/carousel_avatar_size"
        android:background="@drawable/bg_avatar_circle"
        android:padding="16dp"
        android:src="@drawable/profile"
        app:tint="@color/pulse_avatar_icon" />
    
    <TextView
        android:id="@+id/carouselContactName"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:text="Magdalena"
        android:textSize="10sp"
        android:textColor="@color/pulse_text_primary"
        android:maxLines="1"
        android:maxWidth="64dp"
        android:ellipsize="end"
        android:gravity="center" />
</LinearLayout>
